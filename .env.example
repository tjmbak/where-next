NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Leave empty to use the built-in OpenStreetMap raster style.
NEXT_PUBLIC_MAP_STYLE_URL=

# Supabase (required for auth, saves, drops, push, monetization)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Enables client-side analytics when deployed on Vercel.
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Email (Resend) — Engine 2: Retention engine
RESEND_API_KEY=
RESEND_FROM="Where Next <hello@wherenext.fm>"

# Web push (VAPID) — Engine 2: Retention engine
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:hello@wherenext.fm

# Cron secret used by Vercel Cron and any manual triggering
CRON_SECRET=

# Affiliate partner tags — Engine 5: Monetization
BOOKING_AID=
SKYSCANNER_PARTNER_ID=
GYG_PARTNER_ID=
VIAGOGO_AID=

# Stripe — Engine 5: Monetization
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONCIERGE_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# OpenAI — for the existing research draft tooling and Engine 6 ingestion
OPENAI_API_KEY=
